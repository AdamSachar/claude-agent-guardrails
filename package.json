{
  "name": "claude-agent-guardrails",
  "version": "0.1.0",
  "description": "Cost and safety guardrails for autonomous Claude Code agents.",
  "type": "module",
  "license": "MIT",
  "author": "Adam Sacharowitz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamSachar/claude-agent-guardrails.git"
  },
  "bugs": {
    "url": "https://github.com/AdamSachar/claude-agent-guardrails/issues"
  },
  "homepage": "https://github.com/AdamSachar/claude-agent-guardrails#readme",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "ai-agents",
    "guardrails",
    "agent-safety",
    "cost-control",
    "prompt-injection"
  ],
  "bin": {
    "claude-agent-guardrails": "dist/cli/install.js"
  },
  "files": [
    "dist",
    "guardrails.config.json",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build",
    "pack:dry": "npm run build && npm pack --dry-run",
    "install-hooks": "node dist/cli/install.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.10"
  }
}
